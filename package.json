{
  "name": "orange-groove",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "description": "Wi-Fi multi-device group-play music party. Host streams local files to guests over LAN. PWA + Capacitor ready.",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "dev:server": "tsx server/index.ts",
    "dev:full": "concurrently \"npm run dev\" \"npm run dev:server\"",
    "build": "tsc --noEmit && vite build",
    "build:native": "tsc --noEmit && vite build --mode native",
    "preview": "vite preview --host=0.0.0.0",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "server": "tsx server/index.ts",
    "icons": "bash scripts/generate-icons.sh",
    "cap:add:android": "npx cap add android",
    "cap:add:ios": "npx cap add ios",
    "cap:sync": "npm run build:native && npx cap sync",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "android": "npm run build:native && npx cap sync android && npx cap open android",
    "android:setup-signing": "bash scripts/setup-android-signing.sh",
    "android:verify-signing": "bash scripts/verify-signing-setup.sh",
    "android:rotate-key": "bash scripts/rotate-android-upload-key.sh",
    "android:debug": "bash scripts/build-android.sh debug",
    "android:release": "bash scripts/build-android.sh release",
    "android:bundle": "bash scripts/build-android.sh bundle",
    "ios": "npm run build:native && npx cap sync ios && npx cap open ios",
    "ios:setup-fastlane": "bash scripts/setup-ios-fastlane.sh",
    "security:audit": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^6.0.0",
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.6.8",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "buffer": "^6.0.3",
    "capacitor-native-settings": "^7.0.2",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "process": "^0.11.10",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "tailwind-merge": "^3.5.0",
    "trystero": "^0.22.0",
    "uuid": "^11.1.0",
    "vite": "^6.2.0"
  },
  "overrides": {
    "uuid": "$uuid"
  },
  "devDependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/cli": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/uuid": "^10.0.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.12",
    "typescript": "~5.8.2",
    "vitest": "^3.0.0"
  }
}
