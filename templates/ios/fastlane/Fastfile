# Orange Groove — iOS lanes (Capacitor)
# After: npx cap add ios && bash scripts/setup-ios-fastlane.sh
# Docs: docs/IOS_SIGNING.md  docs/FASTLANE_MATCH.md

default_platform(:ios)

platform :ios do
  before_all do
    setup_ci if ENV["CI"]
  end

  desc "Sync web assets into the iOS project (run from repo root before lane if needed)"
  lane :sync_web do
    sh("cd ../.. && npm ci && npm run build && npx cap sync ios")
  end

  desc "Fetch certs/profiles via Match (readonly on CI)"
  lane :certs do
    api_key = app_store_connect_api_key_from_env
    match(
      type: "appstore",
      readonly: is_ci,
      api_key: api_key,
      app_identifier: "com.orangegroove.app"
    )
  end

  desc "Build signed IPA (App Store / TestFlight)"
  lane :build do
    api_key = app_store_connect_api_key_from_env
    match(
      type: "appstore",
      readonly: is_ci,
      api_key: api_key,
      app_identifier: "com.orangegroove.app"
    )

    # Capacitor default Xcode structure: ios/App/App.xcworkspace
    workspace = File.exist?("App/App.xcworkspace") ? "App/App.xcworkspace" : "App.xcworkspace"
    scheme = "App"

    build_app(
      workspace: workspace,
      scheme: scheme,
      export_method: "app-store",
      clean: true,
      output_directory: "./build",
      output_name: "OrangeGroove.ipa"
    )
  end

  desc "Upload IPA to TestFlight"
  lane :beta do
    build
    api_key = app_store_connect_api_key_from_env
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      ipa: "./build/OrangeGroove.ipa"
    )
  end

  desc "Build + TestFlight (alias)"
  lane :release do
    beta
  end

  error do |lane, exception|
    UI.error("Lane #{lane} failed: #{exception.message}")
  end
end

def is_ci
  ENV["CI"].to_s == "true" || ENV["GITHUB_ACTIONS"].to_s == "true"
end

def app_store_connect_api_key_from_env
  key_id = ENV["APPSTORE_KEY_ID"]
  issuer_id = ENV["APPSTORE_ISSUER_ID"]
  key_content = ENV["APPSTORE_PRIVATE_KEY"]

  if key_id.to_s.empty? || issuer_id.to_s.empty? || key_content.to_s.empty?
    UI.user_error!("Missing APPSTORE_KEY_ID / APPSTORE_ISSUER_ID / APPSTORE_PRIVATE_KEY")
  end

  # GitHub secrets often store the .p8 with literal \n — normalize newlines
  key_content = key_content.gsub("\\n", "\n")

  app_store_connect_api_key(
    key_id: key_id,
    issuer_id: issuer_id,
    key_content: key_content,
    is_key_content_base64: ENV["APPSTORE_PRIVATE_KEY_BASE64"] == "true",
    duration: 1200,
    in_house: false
  )
end
